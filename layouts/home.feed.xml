{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
	<title>{{ site.Title }}</title>
	<atom:link href="{{ .Permalink }}feed/" rel="self" type="application/rss+xml" />
	<link>{{ .Permalink }}</link>
	<description>{{ site.Params.description }}</description>
	<language>en-US</language>
{{- range first 10 (where site.RegularPages "Section" "posts").ByDate.Reverse }}
	<item>
		<title>{{ .Title }}</title>
		<link>{{ .Permalink }}</link>
		<dc:creator><![CDATA[{{ .Params.author }}]]></dc:creator>
		<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
		{{- range .Params.categories }}{{ with site.GetPage (printf "/categories/%s" .) }}
		<category><![CDATA[{{ .Title }}]]></category>{{ end }}{{ end }}
		{{- range .Params.tags }}
		<category><![CDATA[{{ . }}]]></category>{{ end }}
		<guid isPermaLink="true">{{ .Permalink }}</guid>
		<description><![CDATA[{{ .Summary | plainify | truncate 300 }}]]></description>
		<content:encoded><![CDATA[{{ .Content }}]]></content:encoded>
	</item>
{{- end }}
</channel>
</rss>
